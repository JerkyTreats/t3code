  "adaptation": "T3-aware locally authored router and playbooks; not an upstream byte-for-byte install",
  "review_date": "2026-10-10",
  "review_scope": "Upstream guide and mode instructions, selected playbook mechanics and authority-sensitive passages; full final authored bundle; native T3 tool contracts. Upstream executable helpers and remaining pstack skills/agents/automation packs are not installed or assessed as executable code.",
  "provenance_limits": "Fetched official HTTPS repository; selected source bytes matched exact Git objects. No independent commit-signature or author-authenticity verification.",
  "security_findings": [
    {
      "id": "PT3-01",
      "source_risk": "Upstream mode grants broad external actions and unconditional workflow publication.",
      "adaptation": "Removed. Existing user grants and repository rules govern commits, pushes, PR creation, merging, messaging, dependencies and destructive actions."
    },
    {
      "id": "PT3-02",
      "source_risk": "Cursor cloud agents, hard-coded model names, loop, watcher and program-store executables are host-specific.",
      "adaptation": "No scripts, dependencies, downloads, listeners or cloud transport installed. Use live T3 capability catalog, task IDs, parent completion delivery, owned PR watches and explicitly authorized schedules."
    },
    {
      "id": "PT3-03",
      "source_risk": "Workspace/transcript scans, force cleanup and reset-oriented PR mechanics can expose or delete unrelated work.",
      "adaptation": "Task-owned bounded timeline reads; preserve dirty work; no live userdata or unrelated transcript scans; exact cleanup scope and separate deletion authorization."
    },
    {
      "id": "PT3-04",
      "source_risk": "Instruction-only routing is not enforcement and cannot prove behavioral compliance.",
      "adaptation": "Record static validation honestly; no LLM eval, unattended runtime reliability or app-level persistent-mode claim."
    },
    {
      "id": "PT3-05",
      "source_risk": "Skills can influence future tool execution even without bundled executable code.",
      "adaptation": "Self-contained playbooks defer to active permissions and native tool contracts. Actual future operations remain within the invoking task grant."
    }
  ],
