#!/bin/bash
set -euo pipefail

agent=$({{STOCK_OMARCHY_DEFAULT_AGENT}})
[[ $agent == t3code ]] || exec {{STOCK_OMARCHY_AGENT}} "$@"

prompt_set=false
prompt=""
while (($#)); do
  case "$1" in
    --inline | --pick)
      shift
      ;;
    --prompt)
      [[ $# -ge 2 ]] || { echo "--prompt needs a value" >&2; exit 2; }
      prompt_set=true
      prompt=$2
      shift 2
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      exit 2
      ;;
  esac
done

workspace_root=$(pwd -P)
if [[ $workspace_root == ${HOME:-} && -d ${HOME:-}/Work ]]; then
  cd "$HOME/Work"
  workspace_root=$(pwd -P)
fi

if [[ $prompt_set == true ]]; then
  [[ -n $prompt ]] || { echo "T3 Code submit prompts must not be empty" >&2; exit 2; }
  printf '%s\0%s\0%s' "$workspace_root" submit "$prompt" |
    jq -Rs '{contractVersion: 1, workspace: split("\u0000")[0], action: split("\u0000")[1], prompt: split("\u0000")[2]}' |
    {{T_CODE_LAUNCHER}} activate
else
  printf '%s\0%s' "$workspace_root" open |
    jq -Rs '{contractVersion: 1, workspace: split("\u0000")[0], action: split("\u0000")[1]}' |
    {{T_CODE_LAUNCHER}} activate
fi
