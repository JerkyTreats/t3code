        "text": "<<<<<<< 9c80a4c63bb0d8391301e6e17bc7afe5226dbce5\n    return {\n      h1({ node, ...props }) {\n        return reviewableBlock(node, <h1 {...props} />);\n      },\n      h2({ node, ...props }) {\n        return reviewableBlock(node, <h2 {...props} />);\n      },\n      h3({ node, ...props }) {\n        return reviewableBlock(node, <h3 {...props} />);\n      },\n      h4({ node, ...props }) {\n        return reviewableBlock(node, <h4 {...props} />);\n      },\n      h5({ node, ...props }) {\n        return reviewableBlock(node, <h5 {...props} />);\n      },\n      h6({ node, ...props }) {\n        return reviewableBlock(node, <h6 {...props} />);\n      },\n      p({ node, children, ...props }) {\n        return reviewableBlock(\n          node,\n          <p {...props}>{renderSkillInlineMarkdownChildren(children, skills)}</p>,\n        );\n      },\n      blockquote({ node, children, ...props }) {\n        const alert =\n          GITHUB_ALERT_PRESENTATIONS[\n            String((props as Record<string, unknown>)[\"data-alert\"] ?? \"\")\n          ];\n        if (!alert) {\n          return reviewableBlock(node, <blockquote {...props}>{children}</blockquote>);\n        }\n        // Not a <blockquote>: the stylesheet mutes those, and an alert's body is ordinary\n        // text under a colored title — which is how the host renders it.\n        return reviewableBlock(\n          node,\n          <div role=\"note\" className={cn(\"my-1 border-l-2 pl-3\", alert.borderClassName)}>\n            <p className={cn(\"flex items-center gap-1.5 font-medium\", alert.titleClassName)}>\n              <alert.Icon aria-hidden className=\"size-3.5 shrink-0\" />\n              {alert.label}\n            </p>\n            {children}\n          </div>,\n        );\n      },\n      ol({ node, start, style, ...props }) {\n        const itemCount =\n          node?.children?.filter((child) => child.type === \"element\" && child.tagName === \"li\")\n            .length ?? 0