        "text": "<<<<<<< 9c80a4c63bb0d8391301e6e17bc7afe5226dbce5\nconst normalizeClosedTabs = (\n  tabs: ReadonlyArray<ClosedPreviewTab>,\n): ReadonlyArray<ClosedPreviewTab> => {\n  const ordered = tabs.toSorted((left, right) => right.sequence - left.sequence);\n  const retainedClosed = new Set(\n    ordered\n      .filter((entry) => entry.status === \"closed\")\n      .slice(0, CLOSED_PREVIEW_TAB_LIMIT)\n      .map((entry) => entry.reservationId),\n  );\n  return ordered.filter(\n    (entry) => entry.status === \"pending\" || retainedClosed.has(entry.reservationId),\n  );\n};\n\nexport function reserveClosedPreviewTab(\n  ref: ScopedThreadRef,\n  snapshot: PreviewSessionSnapshot,\n  overlay: DesktopPreviewOverlay | null,\n): ClosedPreviewTab {\n  let reservation: ClosedPreviewTab | null = null;\n  updateThreadPreviewState(ref, (current) => {\n    const sequence = current.nextClosedTabSequence;\n    reservation = {\n      reservationId: `${sequence}:${snapshot.tabId}`,\n      sequence,\n      status: \"pending\",\n      tabId: snapshot.tabId,\n      url: snapshot.navStatus._tag === \"Idle\" ? null : snapshot.navStatus.url,\n      viewport: snapshot.viewport ?? FILL_PREVIEW_VIEWPORT,\n      zoomFactor: overlay?.zoomFactor ?? 1,\n      colorScheme: overlay?.colorScheme ?? \"system\",\n    };\n    return {\n      ...current,\n      closedTabs: normalizeClosedTabs([reservation, ...current.closedTabs]),\n      nextClosedTabSequence: sequence + 1,\n    };\n  });\n  return reservation!;\n}\n\nexport function commitClosedPreviewTab(ref: ScopedThreadRef, reservationId: string): void {\n  updateThreadPreviewState(ref, (current) => ({\n    ...current,\n    closedTabs: normalizeClosedTabs(\n      current.closedTabs.map((entry) =>\n        entry.reservationId === reservationId ? { ...entry, status: \"closed\" } : entry,\n      ),\n    ),\n  }));\n}\n\nexport function rollbackClosedPreviewTab(ref: ScopedThreadRef, reservationId: string): void {\n  updateThreadPreviewState(ref, (current) => ({\n    ...current,\n    closedTabs: normalizeClosedTabs(\n      current.closedTabs.filter((entry) => entry.reservationId !== reservationId),\n    ),\n  }));\n}\n\nexport function takeClosedPreviewTab(ref: ScopedThreadRef): ClosedPreviewTab | null {\n  const closedTab = readThreadPreviewState(ref).closedTabs[0] ?? null;\n  if (!closedTab || closedTab.status === \"pending\") return null;\n  updateThreadPreviewState(ref, (current) => ({\n    ...current,\n    closedTabs: normalizeClosedTabs(current.closedTabs.slice(1)),\n  }));\n  return closedTab;\n}\n\nexport function restoreClosedPreviewTab(ref: ScopedThreadRef, closedTab: ClosedPreviewTab): void {\n  updateThreadPreviewState(ref, (current) => ({\n    ...current,\n    closedTabs: normalizeClosedTabs([{ ...closedTab, status: \"closed\" }, ...current.closedTabs]),\n  }));\n}\n\nexport function setPendingPreviewRestoration(\n  ref: ScopedThreadRef,\n  tabId: string,\n  restoration: PreviewDesktopRestoration,\n): void {\n  updateThreadPreviewState(ref, (current) => ({\n    ...current,\n    pendingRestorations: { ...current.pendingRestorations, [tabId]: restoration },\n  }));\n}\n\nexport function clearPendingPreviewRestoration(ref: ScopedThreadRef, tabId: string): void {\n  updateThreadPreviewState(ref, (current) => {\n    if (!current.pendingRestorations[tabId]) return current;\n    const { [tabId]: _removed, ...pendingRestorations } = current.pendingRestorations;\n    return { ...current, pendingRestorations };\n  });\n}\n\nexport function removePreviewThread(ref: ScopedThreadRef): void {\n  const threadKey = scopedThreadKey(ref);\n  appAtomRegistry.set(previewStateAtom(threadKey), EMPTY_THREAD_PREVIEW_STATE);\n  syncActivePreviewThread(threadKey, EMPTY_THREAD_PREVIEW_STATE);\n  changedPreviewThreadKeys.delete(threadKey);\n}\n\n=======\n>>>>>>> 761d4bac1c238ea7af4dd36b56719ad5e30771c3\n"
