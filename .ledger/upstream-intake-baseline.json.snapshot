        "text": "<<<<<<< 9c80a4c63bb0d8391301e6e17bc7afe5226dbce5\n\nfunction makeBootstrapProjection(\n  commands: ReadonlyArray<OrchestrationCommand>,\n  workspaceRoot = \"/tmp/project\",\n) {\n  return {\n    getProjectShellById: (projectId: ProjectId) =>\n      Effect.succeed(\n        Option.some({\n          id: projectId,\n          title: \"Bootstrap project\",\n          workspaceRoot,\n          defaultModelSelection: null,\n          scripts: [],\n          createdAt: \"2026-01-01T00:00:00.000Z\",\n          updatedAt: \"2026-01-01T00:00:00.000Z\",\n        }),\n      ),\n    getThreadDetailById: (threadId: ThreadId) => {\n      const create = commands.find(\n        (command): command is Extract<OrchestrationCommand, { type: \"thread.create\" }> =>\n          command.type === \"thread.create\" && command.threadId === threadId,\n      );\n      if (!create) return Effect.succeed(Option.none());\n      const metas = commands.filter(\n        (command): command is Extract<OrchestrationCommand, { type: \"thread.meta.update\" }> =>\n          command.type === \"thread.meta.update\" && command.threadId === threadId,\n      );\n      const activities = commands\n        .filter(\n          (command): command is Extract<OrchestrationCommand, { type: \"thread.activity.append\" }> =>\n            command.type === \"thread.activity.append\" && command.threadId === threadId,\n        )\n        .map((command) => command.activity);\n      const latestMeta = metas.at(-1);\n      return Effect.succeed(\n        Option.some({\n          id: threadId,\n          projectId: create.projectId,\n          title: create.title,\n          modelSelection: create.modelSelection,\n          runtimeMode: create.runtimeMode,\n          interactionMode: create.interactionMode,\n          branch: latestMeta?.branch ?? create.branch,\n          worktreePath: latestMeta?.worktreePath ?? create.worktreePath,\n          latestTurn: null,\n          createdAt: create.createdAt,\n         