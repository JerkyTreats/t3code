        "text": "<<<<<<< 9c80a4c63bb0d8391301e6e17bc7afe5226dbce5\nimport type { ThreadOutboxNoticeMessage } from \"./ThreadOutboxNotice\";\nimport {\n  captureComposerScreenshot,\n  type ComposerScreenshotCapture,\n  resolveComposerScreenshotCapture,\n} from \"../../fork/composerScreenshot\";\n=======\nimport {\n  createComposerScrollGestureState,\n  recordComposerScrollGestureEvent,\n  resetComposerScrollGesture,\n  suppressActiveComposerScrollGesture,\n} from \"./composerScrollGesture\";\nimport { selectionHoldsComposerOpen } from \"./composerSelectionHold\";\nimport { prepareVideoFirstFrame } from \"../../lib/videoFirstFrame\";\n\nfunction ComposerVideoThumbnail({ file }: { file: File }) {\n  const setVideo = useCallback(\n    (video: HTMLVideoElement | null) => {\n      if (!video) return;\n      return attachVideoThumbnail(video, file);\n    },\n    [file],\n  );\n\n  return (\n    <video\n      ref={setVideo}\n      muted\n      playsInline\n      preload=\"metadata\"\n      aria-hidden=\"true\"\n      onLoadedMetadata={(event) => prepareVideoFirstFrame(event.currentTarget)}\n      className=\"pointer-events-none absolute inset-0 size-full object-cover\"\n    />\n  );\n}\n>>>>>>> 761d4bac1c238ea7af4dd36b56719ad5e30771c3\n"
