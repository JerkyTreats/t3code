        "text": "<<<<<<< 9c80a4c63bb0d8391301e6e17bc7afe5226dbce5\nconst COMPOSER_FLOATING_LAYER_SELECTOR = [\n  '[data-composer-drawer-layer=\"true\"]',\n  '[data-slot=\"popover-popup\"]',\n  '[data-slot=\"menu-popup\"]',\n  '[data-slot=\"select-popup\"]',\n  '[data-slot=\"combobox-popup\"]',\n  '[data-slot=\"autocomplete-popup\"]',\n].join(\",\");\n\nconst COMPOSER_SCREENSHOT_CAPTURE_ERROR = \"Unable to capture a screenshot. Try again.\";\n\nexport function isComposerScreenshotActionDisabled(input: {\n  isSubmitting: boolean;\n  isApprovalPending: boolean;\n  isUserInputPending: boolean;\n  isProjectMissing: boolean;\n  isAttachmentCompressionPending: boolean;\n}): boolean {\n  return (\n    input.isSubmitting ||\n    input.isApprovalPending ||\n    input.isUserInputPending ||\n    input.isProjectMissing ||\n    input.isAttachmentCompressionPending\n  );\n}\n\nexport function hasPendingComposerImageWork(pendingCount: number): boolean {\n  return pendingCount > 0;\n}\n\nexport const ComposerScreenshotControl = memo(function ComposerScreenshotControl(props: {\n  captureScreenshot: ComposerScreenshotCapture;\n  disabled: boolean;\n  reservePendingImage: () => (() => void) | null;\n  addComposerImages: (files: File[]) => Promise<void>;\n  onCaptureError: (message: string) => void;\n  onRestoreComposerFocus: () => void;\n}) {\n  const {\n    captureScreenshot,\n    disabled: externallyDisabled,\n    reservePendingImage,\n    addComposerImages,\n    onCaptureError,\n    onRestoreComposerFocus,\n  } = props;\n  const [isCaptureInFlight, setIsCaptureInFlight] = useState(false);\n  const captureInFlightRef = useRef(false);\n  const captureOwnershipRef = useRef<{\n    active: boolean;\n    releaseReservation: () => void;\n  } | null>(null);\n  const mountedRef = useRef(true);\n\n  const releaseCaptureOwnership = useCallback(\n    (ownership: { active: boolean; releaseReservation: () => void }) => {\n      if (!ownership.active) return;\n      ownership.active = false;\n      if (captureOwnershipRef.current === ownership) {\n        captureOwnershipRef.current = null;\n      }\n      ownership.releaseReservation();\n    },\n    [],\n  );\n\n  useEffect(() => {\n    mountedRef.current = true;\n    return () => {\n      mountedRef.current = false;\n      const ownership = captureOwnershipRef.current;\n      if (ownership) {\n        releaseCaptureOwnership(ownership);\n      }\n    };\n  }, [releaseCaptureOwnership]);\n\n  const onCapture = useCallback(\n    (focusOwner: HTMLButtonElement) => {\n      if (externallyDisabled || captureInFlightRef.current) return;\n      const releaseReservation = reservePendingImage();\n      if (releaseReservation === null) return;\n      const ownership = { active: true, releaseReservation };\n      captureOwnershipRef.current = ownership;\n      captureInFlightRef.current = true;\n      setIsCaptureInFlight(true);\n\n      void captureComposerScreenshot(captureScreenshot)\n        .then(async (file) => {\n          if (captureOwnershipRef.current !== ownership || file === null) return;\n          // Transfer the native-capture reservation to shared admission in\n          // one microtask. addComposerImages reserves synchronously before\n          // its first await, so submission never observes an ownership gap.\n          releaseCaptureOwnership(ownership);\n          await addComposerImages([file]);\n        })\n        .catch(() => {\n          if (mountedRef.current) {\n            onCaptureError(COMPOSER_SCREENSHOT_CAPTURE_ERROR);\n          }\n        })\n        .finally(() => {\n          releaseCaptureOwnership(ownership);\n          captureInFlightRef.current = false;\n          if (!mountedRef.current) return;\n          setIsCaptureInFlight(false);\n          window.requestAnimationFrame(() => {\n            if (document.activeElement === focusOwner) {\n              onRestoreComposerFocus();\n            }\n          });\n        });\n    },\n    [\n      addComposerImages,\n      captureScreenshot,\n      externallyDisabled,\n      onCaptureError,\n      onRestoreComposerFocus,\n      releaseCaptureOwnership,\n      reservePendingImage,\n    ],\n  );\n\n  const disabled = externallyDisabled || isCaptureInFlight;\n  return (\n    <Tooltip>\n      <TooltipTrigger\n        render={\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            size=\"icon-sm\"\n            className=\"pointer-events-auto rounded-full border-border/65 bg-background/92 text-muted-foreground shadow-sm backdrop-blur-md hover:bg-background hover:text-foreground\"\n            disabled={disabled}\n            aria-label=\"Attach screenshot\"\n            data-chat-composer-screenshot=\"true\"\n            onClick={(event) => onCapture(event.currentTarget)}\n          />\n        }\n      >\n        <CameraIcon className={cn(\"size-4\", isCaptureInFlight && \"animate-pulse\")} />\n      </TooltipTrigger>\n      <TooltipPopup side=\"top\">Attach screenshot</TooltipPopup>\n    </Tooltip>\n  );\n});\n\nconst ComposerRuntimeModeControl = memo(function ComposerRuntimeModeControl(props: {\n  runtimeMode: RuntimeMode;\n  onRuntimeModeChange: (mode: RuntimeMode) => void;\n}) {\n  const runtimeModeOption = runtimeModeConfig[props.runtimeMode];\n  const RuntimeModeIcon = runtimeModeOption.icon;\n\n  return (\n    <Tooltip>\n      <Select\n        value={props.runtimeMode}\n        onValueChange={(value) => {\n          if (!value || value === props.runtimeMode) return;\n          props.onRuntimeModeChange(value);\n        }}\n      >\n        <TooltipTrigger\n          render={\n            <SelectTrigger\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"pointer-events-auto size-8 justify-center rounded-full border border-border/65 bg-background/92 p-0 text-muted-foreground shadow-sm backdrop-blur-md hover:bg-background hover:text-foreground [&_[data-slot=select-icon]]:hidden\"\n              aria-label={`Access: ${runtimeModeOption.label}`}\n            />\n          }\n        >\n          <RuntimeModeIcon className=\"size-4\" />\n        </TooltipTrigger>\n        <SelectPopup alignItemWithTrigger={false}>\n          {runtimeModeOptions.map((mode) => {\n            const option = runtimeModeConfig[mode];\n            const OptionIcon = option.icon;\n            return (\n              <SelectItem key={mode} value={mode} hideIndicator className=\"min-w-64 py-2\">\n                <div className=\"grid min-w-0 gap-0.5\">\n                  <span className=\"inline-flex items-center gap-1.5 font-medium text-foreground\">\n                    <OptionIcon className=\"size-3.5 shrink-0 text-muted-foreground\" />\n                    {option.label}\n                  </span>\n                  <span className=\"text-muted-foreground text-xs leading-4\">\n                    {option.description}\n                  </span>\n                </div>\n              </SelectItem>\n            );\n          })}\n        </SelectPopup>\n      </Select>\n      <TooltipPopup side=\"top\">{runtimeModeOption.description}</TooltipPopup>\n    </Tooltip>\n  );\n});\n\n=======\n>>>>>>> 761d4bac1c238ea7af4dd36b56719ad5e30771c3\n"
